+    def _servingrom_queue_counts(self) -> tuple[int, int]:
+        running = len(getattr(self.scheduler, "running", ()))
+        waiting = len(getattr(self.scheduler, "waiting", ())) + len(
+            getattr(self.scheduler, "skipped_waiting", ())
+        )
+        return running, waiting
+
+    def _servingrom_schedule(self) -> SchedulerOutput:
+        if not self._servingrom.enabled:
+            return self.scheduler.schedule()
+        iteration_id = self._servingrom.next_iteration_id()
+        schedule_begin_wall_ns = time.time_ns()
+        schedule_begin_mono_ns = time.monotonic_ns()
+        running_before, waiting_before = self._servingrom_queue_counts()
+        scheduler_output = self.scheduler.schedule()
+        scheduler_output.servingrom_iteration_id = iteration_id
+        schedule_end_mono_ns = time.monotonic_ns()
+        schedule_end_wall_ns = time.time_ns()
+
+        new_ids = {item.req_id for item in scheduler_output.scheduled_new_reqs}
+        cached = scheduler_output.scheduled_cached_reqs
+        cached_before = {
+            req_id: (computed, output)
+            for req_id, computed, output in zip(
+                cached.req_ids, cached.num_computed_tokens, cached.num_output_tokens
+            )
+        }
+        new_before = {
+            item.req_id: item.num_computed_tokens
+            for item in scheduler_output.scheduled_new_reqs
+        }
+        new_blocks = {
+            item.req_id: sum(len(group) for group in item.block_ids)
+            for item in scheduler_output.scheduled_new_reqs
+        }
+        new_blocks.update(
+            {
+                req_id: (
+                    sum(len(group) for group in groups) if groups is not None else 0
+                )
+                for req_id, groups in zip(cached.req_ids, cached.new_block_ids)
+            }
+        )
+        members = []
+        for request_id, scheduled_tokens in scheduler_output.num_scheduled_tokens.items():
+            request = getattr(self.scheduler, "requests", {}).get(request_id)
+            computed_before, output_before = cached_before.get(
+                request_id, (new_before.get(request_id, 0), 0)
+            )
+            resumed = request_id in cached.resumed_req_ids
+            members.append(
+                {
+                    "request_id": request_id,
+                    "request_state_before": (
+                        "new"
+                        if request_id in new_ids
+                        else "resumed"
+                        if resumed
+                        else getattr(getattr(request, "status", None), "name", "unknown")
+                    ),
+                    "scheduled_tokens": scheduled_tokens,
+                    "computed_tokens_before": computed_before,
+                    "output_tokens_before": output_before,
+                    "context_tokens_before": computed_before,
+                    "new_kv_blocks": new_blocks.get(request_id, 0),
+                    "resumed": resumed,
+                    "preempted": request_id
+                    in (scheduler_output.preempted_req_ids or set()),
+                }
+            )
+
+        state = {
+            "iteration_id": iteration_id,
+            "schedule_begin_wall_ns": schedule_begin_wall_ns,
+            "schedule_begin_mono_ns": schedule_begin_mono_ns,
+            "schedule_end_wall_ns": schedule_end_wall_ns,
+            "schedule_end_mono_ns": schedule_end_mono_ns,
+            "running_before": running_before,
+            "waiting_before": waiting_before,
+            "members": members,
+            "model_submit_begin_wall_ns": None,
+            "model_submit_begin_mono_ns": None,
+            "model_submit_end_wall_ns": None,
+            "model_submit_end_mono_ns": None,
+        }
+        setattr(scheduler_output, "_servingrom_state", state)
+        self._servingrom.emit(
+            "scheduler_membership",
+            {"iteration_id": iteration_id, "members": members},
+        )
+        return scheduler_output
+
+    def _servingrom_execute_model(self, scheduler_output: SchedulerOutput):
+        if not self._servingrom.enabled:
+            return self.model_executor.execute_model(
+                scheduler_output, non_block=True
+            )
+        state = getattr(scheduler_output, "_servingrom_state", None)
+        if state is not None:
+            state["model_submit_begin_wall_ns"] = time.time_ns()
+            state["model_submit_begin_mono_ns"] = time.monotonic_ns()
+        future = self.model_executor.execute_model(scheduler_output, non_block=True)
+        if state is not None:
+            state["model_submit_end_mono_ns"] = time.monotonic_ns()
+            state["model_submit_end_wall_ns"] = time.time_ns()
+        return future
+
+    def _servingrom_update_from_output(self, scheduler_output, model_output):
+        if not self._servingrom.enabled:
+            return self.scheduler.update_from_output(scheduler_output, model_output)
+        engine_core_outputs = self.scheduler.update_from_output(
+            scheduler_output, model_output
+        )
+        state = getattr(scheduler_output, "_servingrom_state", None)
+        if state is None:
+            return engine_core_outputs
+
+        output_update_end_mono_ns = time.monotonic_ns()
+        output_update_end_wall_ns = time.time_ns()
+        running_after, waiting_after = self._servingrom_queue_counts()
+        output_before = {
+            member["request_id"]: member["output_tokens_before"]
+            for member in state["members"]
+        }
+        output_members = []
+        for grouped_outputs in engine_core_outputs.values():
+            for output in grouped_outputs.outputs:
+                count = len(output.new_token_ids)
+                start = output_before.get(output.request_id, 0)
+                output_members.append(
+                    {
+                        "request_id": output.request_id,
+                        "new_token_count": count,
+                        "generated_token_index_start": start if count else None,
+                        "generated_token_index_end": start + count - 1 if count else None,
+                        "is_first_token": bool(count and start == 0),
+                        "finish_reason": (
+                            str(output.finish_reason)
+                            if output.finish_reason is not None
+                            else None
+                        ),
+                        "stop_reason": (
+                            str(output.stop_reason)
+                            if output.stop_reason is not None
+                            else None
+                        ),
+                    }
+                )
+                if output.finish_reason is not None:
+                    self._servingrom.emit(
+                        "engine_request_terminal",
+                        {
+                            "iteration_id": state["iteration_id"],
+                            "finish_reason": str(output.finish_reason),
+                            "stop_reason": (
+                                str(output.stop_reason)
+                                if output.stop_reason is not None
+                                else None
+                            ),
+                        },
+                        request_id=output.request_id,
+                    )
+        if output_members:
+            self._servingrom.emit(
+                "engine_output_batch",
+                {"iteration_id": state["iteration_id"], "members": output_members},
+            )
+
+        submit_begin = state["model_submit_begin_mono_ns"]
+        submit_end = state["model_submit_end_mono_ns"]
+        self._servingrom.emit(
+            "scheduler_iteration",
+            {
+                **{key: value for key, value in state.items() if key != "members"},
+                "output_update_end_wall_ns": output_update_end_wall_ns,
+                "output_update_end_mono_ns": output_update_end_mono_ns,
+                "scheduler_duration_ns": (
+                    state["schedule_end_mono_ns"] - state["schedule_begin_mono_ns"]
+                ),
+                "host_model_submit_duration_ns": (
+                    submit_end - submit_begin
+                    if submit_begin is not None and submit_end is not None
+                    else None
+                ),
+                "iteration_host_duration_ns": (
+                    output_update_end_mono_ns - state["schedule_begin_mono_ns"]
+                ),
+                "waiting_after": waiting_after,
+                "running_after": running_after,
+                "token_budget": getattr(
+                    self.scheduler, "max_num_scheduled_tokens", None
+                ),
+                "scheduled_tokens_total": scheduler_output.total_num_scheduled_tokens,
+                "scheduled_request_count": len(scheduler_output.num_scheduled_tokens),
+                "new_count": len(scheduler_output.scheduled_new_reqs),
+                "resumed_count": len(
+                    scheduler_output.scheduled_cached_reqs.resumed_req_ids
+                ),
+                "preempted_count": len(scheduler_output.preempted_req_ids or set()),
+                "finished_count": len(scheduler_output.finished_req_ids),
+                "kv_blocks_allocated": sum(
+                    member["new_kv_blocks"] for member in state["members"]
+                ),
+                "kv_blocks_freed": None,
+                "async_scheduling": self.async_scheduling,
+            },
+        )
+        return engine_core_outputs
 
